# Copy to .env and fill in:  cp .env.example .env
# Admin password (only for you) and viewer code (what you give to project users).
NANOSKOP_ADMIN_PASSWORD=change-this-admin-password
NANOSKOP_VIEWER_CODE=change-this-viewer-code
# 1 = the site is served over HTTPS (recommended). 0 = plain HTTP inside the institution network only.
NANOSKOP_SECURE_COOKIE=1
# Largest own file a user may upload (MB).
NANOSKOP_MY_MAX_MB=50
NANOSKOP_PORT=8000
